---
interface Props {
  sigil: string;
}

const { sigil } = Astro.props;
---

<span
  aria-hidden="true"
  set:html={sigil}
  data-sigil
  class="pointer-events-none absolute top-11 -left-10 z-10 hidden font-serif text-3xl leading-none text-red-800 select-none md:block lg:-left-12 dark:text-red-400 [&_svg]:h-[1.1em] [&_svg]:w-auto"
/>

<script>
  /** px: width of the soft pull — like a gaussian blur radius */
  const SIGMA = 50;
  /** how far toward the cursor it leans at the center (0–1) */
  const PULL = 0.3;
  /** spring stiffness */
  const STIFF = 0.08;
  /** * velocity damping  */
  const DAMP = 0.75;

  const sigils = [
    ...document.querySelectorAll<HTMLElement>("[data-sigil]"),
  ].map((el) => ({ el, x: 0, y: 0, vx: 0, vy: 0 }));
  let mx = -1e4,
    my = -1e4;
  addEventListener(
    "pointermove",
    (e: PointerEvent) => ((mx = e.clientX), (my = e.clientY)),
  );

  (function tick() {
    for (const s of sigils) {
      const r = s.el.getBoundingClientRect();
      const dx = mx - (r.left + r.width / 2 - s.x);
      const dy = my - (r.top + r.height / 2 - s.y);
      // gaussian falloff: ~1 at the cursor, fading softly to ~0 past ~3·SIGMA
      const w = PULL * Math.exp(-(dx * dx + dy * dy) / (2 * SIGMA * SIGMA));
      const tx = dx * w;
      const ty = dy * w;
      s.vx = (s.vx + (tx - s.x) * STIFF) * DAMP;
      s.vy = (s.vy + (ty - s.y) * STIFF) * DAMP;
      s.x += s.vx;
      s.y += s.vy;
      s.el.style.translate = `${s.x}px ${s.y}px`;
    }
    requestAnimationFrame(tick);
  })();
</script>
