---
import { feastDate } from "./feastDate";
import { formatDate } from "./formatDate";

interface Props {
  date: Date;
}

const { date } = Astro.props;
const feast = feastDate(date);
const plain = formatDate(date);
---

<time
  datetime={date.toISOString()}
  data-post-time
  data-plain={plain}
  class="post-time all-small-caps shrink-0 text-sm font-medium tracking-wide text-stone-500 tabular-nums transition-colors group-hover:text-red-700 group-hover:duration-0 dark:text-stone-400 dark:group-hover:text-red-400"
>
  {feast}
</time>

<script>
  import { slotText, type SlotTextController } from "slot-text";

  import "slot-text/style.css";

  const reduce =
    typeof matchMedia !== "undefined" &&
    matchMedia("(prefers-reduced-motion: reduce)").matches;

  const opts = reduce
    ? { duration: 0, stagger: 0 }
    : { skipUnchanged: true, stagger: 24, duration: 280 };

  for (const el of document.querySelectorAll<HTMLTimeElement>(
    "time[data-post-time]",
  )) {
    const feast = (el.textContent ?? "").trim();
    const plain = el.dataset.plain ?? feast;
    const roll: SlotTextController = slotText(el, feast);
    const trigger = el.closest<HTMLElement>("[data-feast-trigger]") ?? el;

    trigger.addEventListener("mouseenter", () => roll.set(plain, opts));
    trigger.addEventListener("mouseleave", () => roll.set(feast, opts));
  }
</script>
