---
import { feastDate } from "./feastDate";

interface Props {
  date: Date;
  class?: string;
  /** Wraps the time in a link without adding a tab stop (card link already covers it). */
  href?: string;
}

const { date, class: className, href } = Astro.props;
const feast = feastDate(date);

const Tag = href ? "a" : Fragment;
const linkProps = href ? { href, tabindex: "-1", class: "contents" } : {};
---

<Tag {...linkProps}>
  <time
    datetime={date.toISOString()}
    data-post-time
    class:list={[
      "all-small-caps text-neu-500 dark:text-neu-400 hover:text-accent-700 dark:hover:text-accent-400 pointer-events-auto relative inline-flex h-[1.5cap] w-50 shrink-0 items-center align-bottom text-sm leading-[1.3] font-medium tracking-wide tabular-nums transition-colors select-none before:absolute before:-inset-2 hover:duration-0",
      className,
    ]}
  >
    {feast}
  </time>
</Tag>

<script>
  import { slotText, type SlotTextController } from "slot-text";

  import "slot-text/style.css";
  import { SLOT_TEXT_OPTIONS } from "./animations";
  import { feastDate } from "./feastDate";
  import { formatDate } from "./formatDate";

  for (const el of document.querySelectorAll<HTMLTimeElement>(
    "time[data-post-time]",
  )) {
    const feast = feastDate(el.dateTime);
    const plain = formatDate(el.dateTime);
    const roll: SlotTextController = slotText(el, feast);

    let timer: ReturnType<typeof setTimeout>;
    el.addEventListener("mouseenter", () => {
      timer = setTimeout(() => roll.set(plain, SLOT_TEXT_OPTIONS), 75);
    });
    el.addEventListener("mouseleave", () => {
      clearTimeout(timer);
      roll.set(feast, SLOT_TEXT_OPTIONS);
    });
  }
</script>
