---
import { feastDate } from "./feastDate";
import { formatDate } from "./formatDate";

interface Props {
  date: Date;
  class?: string;
  onclick?: string;
}

const { date, class: className, onclick } = Astro.props;
const feast = feastDate(date);
const plain = formatDate(date);
---

<time
  datetime={date.toISOString()}
  data-post-time
  data-plain={plain}
  class:list={[
    "all-small-caps text-neu-500 dark:text-neu-400 pointer-events-auto relative inline-flex h-[1.5cap] w-50 shrink-0 items-center align-bottom text-sm leading-[1.3] font-medium tracking-wide tabular-nums transition-colors select-none before:absolute before:-inset-2 hover:text-red-700 hover:duration-0 dark:hover:text-red-400",
    className,
  ]}
  onclick={onclick}
>
  {feast}
</time>

<script>
  import { slotText, type SlotTextController } from "slot-text";

  import "slot-text/style.css";
  import { SLOT_TEXT_OPTIONS } from "./animations";

  for (const el of document.querySelectorAll<HTMLTimeElement>(
    "time[data-post-time]",
  )) {
    const feast = (el.textContent ?? "").trim();
    const plain = el.dataset.plain ?? feast;
    const roll: SlotTextController = slotText(el, feast);

    let timer: ReturnType<typeof setTimeout>;
    el.addEventListener("mouseenter", () => {
      timer = setTimeout(() => roll.set(plain, SLOT_TEXT_OPTIONS), 75);
    });
    el.addEventListener("mouseleave", () => {
      clearTimeout(timer);
      roll.set(feast, SLOT_TEXT_OPTIONS);
    });
  }
</script>
