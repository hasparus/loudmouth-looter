---
import type { SocialCard } from "./ogImage";
import { SITE_NAME, SITE_OG_IMAGE, X_HANDLE } from "./siteMeta";

interface Props {
  title: string;
  description: string;
  socialCard: SocialCard | undefined;
  /** "article" for posts; default "website". */
  ogType?: "website" | "article" | undefined;
}

const { title, description, socialCard, ogType = "website" } = Astro.props;

const absolute = (url: string) => new URL(url, import.meta.env.PUBLIC_URL).href;
const image = absolute(socialCard?.image ?? SITE_OG_IMAGE);
const video = socialCard?.video;
---

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{/* twitter:title/description fall back to og:* — no need to repeat them. */}
{X_HANDLE && <meta name="twitter:site" content={X_HANDLE} />}
<meta property="og:image" content={image} />
<meta name="twitter:image" content={image} />
<meta
  name="twitter:card"
  content={video && X_HANDLE ? "player" : "summary_large_image"}
/>
{
  video && (
    <>
      <meta property="og:video" content={absolute(video.src)} />
      <meta property="og:video:secure_url" content={absolute(video.src)} />
      <meta property="og:video:type" content="video/mp4" />
      <meta property="og:video:width" content="1200" />
      <meta property="og:video:height" content="630" />
      {X_HANDLE && (
        <>
          <meta name="twitter:player" content={absolute(video.player)} />
          <meta name="twitter:player:width" content="1200" />
          <meta name="twitter:player:height" content="630" />
        </>
      )}
    </>
  )
}
