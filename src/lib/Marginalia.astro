---
// Semi-hidden vertical marginalia in the page gutters (xl+). Links point to
// sibling apps; plain strings are Latin mottos. Add items by pushing to a side.
interface MarginaliaItem {
  label: string;
  href?: string;
}

const rails: Record<"left" | "right", MarginaliaItem[]> = {
  left: [
    { label: "dungeon motion", href: "https://dungeon-motion.haspar.us/" },
    { label: "astra mortemque superare gradatim" },
  ],
  right: [
    { label: "incipit liber" },
    { label: "kajet", href: "/editor" },
  ],
};

const sides = ["left", "right"] as const;
---

{
  sides.map((side) => (
    <div
      class:list={[
        "pointer-events-none fixed top-1/2 hidden -translate-y-1/2 flex-col items-center gap-12 text-stone-400 xl:flex dark:text-stone-600",
        side === "left" ? "left-12" : "right-12",
      ]}
    >
      {rails[side].map((item, i) => (
        <Fragment>
          {i > 0 && <span class="h-32 w-px bg-stone-300 dark:bg-stone-700" />}
          {item.href ? (
            <a
              href={item.href}
              class:list={[
                "pointer-events-auto font-serif text-xs tracking-[0.4em] lowercase no-underline opacity-50 transition-opacity [writing-mode:vertical-rl] hover:opacity-100",
                side === "left" && "rotate-180",
              ]}
            >
              {item.label}
            </a>
          ) : (
            <span
              class:list={[
                "font-serif text-[0.65rem] tracking-[0.4em] lowercase opacity-40 [writing-mode:vertical-rl]",
                side === "left" && "rotate-180",
              ]}
            >
              {item.label}
            </span>
          )}
        </Fragment>
      ))}
    </div>
  ))
}
