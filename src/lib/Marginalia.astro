---
interface MarginaliaItem {
  label: string;
  href?: string;
}

const rails: Record<"left" | "right", MarginaliaItem[]> = {
  left: [
    {
      // todo: this should be a link to itch.io later
      label: "character sheet",
      href: "https://dungeon-motion.haspar.us/character-sheet",
    },
    { label: "astra mortemque superare gradatim" },
  ],
  right: [
    { label: "incipit liber" },
    { label: "kajet", href: "/editor" },
    { label: "zaduma", href: "https://zaduma.haspar.us/" },
  ],
};

const sides = ["left", "right"] as const;
---

{
  sides.map((side) => (
    <div
      class:list={[
        "text-neu-400 dark:text-neu-600 pointer-events-none fixed top-1/2 hidden -translate-y-1/2 flex-col items-center gap-12 xl:flex",
        side === "left" ? "left-12" : "right-12",
      ]}
    >
      {rails[side].map((item, i) => (
        <Fragment>
          {i > 0 && <span class="bg-neu-300 dark:bg-neu-700 h-32 w-px" />}
          {item.href ? (
            <a
              href={item.href}
              class:list={[
                "pointer-events-auto font-serif text-xs tracking-[0.4em] lowercase no-underline opacity-50 transition-opacity [writing-mode:vertical-rl] hover:opacity-100",
                side === "left" && "rotate-180",
              ]}
            >
              {item.label}
            </a>
          ) : (
            <span
              class:list={[
                "font-serif text-[0.65rem] tracking-[0.4em] lowercase opacity-40 [writing-mode:vertical-rl]",
                side === "left" && "rotate-180",
              ]}
            >
              {item.label}
            </span>
          )}
        </Fragment>
      ))}
    </div>
  ))
}
