---
/**
 * @file Optimized Image component with placeholder
 *
 * This file started as a "fork" / "eject" of Image from `@astrojs/image`,
 * because I couldn't get its props to expose from an Image component that
 * would compose it.
 *
 * The `@ts-ignore` at the top of the original file didn't add much confidence too.
 *
 * @changes
 * - Added placeholder powered by `plaiceholder` CSS strategy.
 * - Limited the width of the image to wide container width, to get smaller & ligher images.
 */

import type { ImageMetadata, ImageTransform } from "astro";
import {
  getImage,
  type LocalImageProps,
  type RemoteImageProps,
} from "astro:assets";
import { readFile } from "node:fs/promises";
import { join } from "node:path";
import { getPlaiceholder } from "plaiceholder";

import { resolvePostImage } from "../postImages";

import "./Image.css";

// All* images with `src`s starting from / are imported from `src/images/` folder.
const SRC_IMAGES_PREFIX = "/";

// Astro rewrites relative markdown image imports to built asset URLs.
const ASTRO_ASSET_PREFIX = "/_astro/";
const VITE_FS_PREFIX = "/@fs/";

// Images with `src` starting with /content/ live in public dir.
const PUBLIC_IMAGES_PREFIX = "/content/";

// No image needs to be wider than this.
// TODO: Support High DPI screens by ensuring Astro emits images 2x of that.
const WIDE_CONTAINER_WIDTH = 774;

type LocalProps = LocalImageProps & {
  aspectRatio?: number | string;
  height?: number | string;
};
type RemoteProps = RemoteImageProps & {
  aspectRatio?: number | string;
  height?: number | string;
};
export type Props = (LocalProps | RemoteProps) & {
  /**
   * Filesystem path of the file the `src` is relative to, e.g. the post's
   * `.mdx` file. Enables `src="./image.png"` colocated with the post.
   */
  relativeTo?: string;
};

type ImageSource =
  | {
      kind: "raw" | "astro-asset" | "vite-fs" | "protocol-relative";
      src: string;
    }
  | { kind: "public"; src: string; image: ImageMetadata }
  | { kind: "asset"; src: string; image: ImageMetadata; fsPath: string }
  | { kind: "optimized-string"; src: string };

const {
  loading = "lazy",
  decoding = "async",
  relativeTo,
  ...props
} = Astro.props as Props;

let width = props.width;
let height = props.height;

const srcInput = await props.src;
let src: string;
if (typeof srcInput === "object" || typeof srcInput === "function") {
  const image = "default" in srcInput ? srcInput.default : srcInput;
  width ??= image.width;
  height ??= image.height;
  src = image.src;
} else {
  src = srcInput;
}

let placeholder: null | {
  backgroundImage: string;
  backgroundPosition: string;
  backgroundSize: string;
  backgroundRepeat: string;
} = null;

const imageSource = await resolveImageSource(src);
applyIntrinsicSizeFromQuery(imageSource.src);

if (imageSource.kind === "public") {
  // Raw public images may contain text or details, so preserve their full ratio.
  const derivedAspectRatio = parseFloat(props.aspectRatio as string);
  const parsedWidth = parseFloat(props.width as string);
  height =
    !isNaN(derivedAspectRatio) && !isNaN(parsedWidth)
      ? parsedWidth / derivedAspectRatio
      : props.height
        ? parseFloat(props.height as string)
        : undefined;
  props.aspectRatio = imageSource.image.width / imageSource.image.height;
  width =
    height != null
      ? height * (imageSource.image.width / imageSource.image.height)
      : undefined;
}

if (imageSource.kind === "asset") {
  props.width ??= imageSource.image.width;
  props.height ??= imageSource.image.height;
  if (imageSource.image.format === "jpg") {
    imageSource.image.format = "webp";
  }
}

const imageForPlaceholder = await readImageForPlaceholder(imageSource);
if (imageForPlaceholder) {
  const { metadata, css } = await getPlaiceholder(imageForPlaceholder, {
    size: 10,
  });
  placeholder = css;

  if (!width && !height && !props.aspectRatio) {
    width ??= metadata.width;
    props.aspectRatio ??= metadata.width / metadata.height;
    width = Math.min(width, WIDE_CONTAINER_WIDTH);
    height = Math.round(width / parseFloat(props.aspectRatio as string));
  }
}

height ??=
  typeof props.aspectRatio === "number"
    ? parseFloat(width as unknown as string) / props.aspectRatio
    : undefined;

props.alt ||= "";
let attrs = {
  src: imageSource.src,
  class: "",
  width,
  height,
  aspectRatio: props.aspectRatio,
};

if (imageSource.kind === "asset" || imageSource.kind === "optimized-string") {
  let attributes;
  props.src = imageSource.src;
  ({ src, attributes } = await getImage({
    ...props,
    src:
      imageSource.kind === "optimized-string"
        ? imageSource.src
        : imageSource.image,
    format: "webp",
    width,
    height,
  } as ImageTransform));
  attrs = { ...attrs, ...attributes, src };
}

async function resolveImageSource(source: string): Promise<ImageSource> {
  if (source.startsWith("raw!")) {
    return { kind: "raw", src: source.slice(4) };
  }

  if (source.startsWith(".")) {
    if (!relativeTo) {
      throw new Error(
        `Relative image src "${source}" requires the relativeTo prop`,
      );
    }
    return {
      kind: "asset",
      src: source,
      ...(await resolvePostImage(relativeTo, source)),
    };
  }

  if (source.startsWith(PUBLIC_IMAGES_PREFIX)) {
    const publicImages = import.meta.glob<
      false,
      string,
      { default: ImageMetadata }
    >("/public/content/**/*");
    const path = "/public" + source;
    const loadImage = publicImages[path];
    if (!loadImage) {
      throw new Error(`Image not found in public/content: ${source}`);
    }
    return { kind: "public", src: source, image: (await loadImage()).default };
  }

  if (source.startsWith(ASTRO_ASSET_PREFIX)) {
    return { kind: "astro-asset", src: source };
  }

  if (source.startsWith(VITE_FS_PREFIX)) {
    return { kind: "vite-fs", src: source };
  }

  if (source.startsWith("//")) {
    return { kind: "protocol-relative", src: source };
  }

  if (source.startsWith(SRC_IMAGES_PREFIX)) {
    const srcImages = import.meta.glob<
      false,
      string,
      { default: ImageMetadata }
    >("/src/images/**/*");
    const path = decodeURIComponent(`/src/images${source}`);
    const loadImage = srcImages[path];
    if (!loadImage) {
      throw new Error(`Image not found in src/images: ${source}`);
    }
    return {
      kind: "asset",
      src: source,
      image: (await loadImage()).default,
      fsPath: join(process.cwd(), path),
    };
  }

  return { kind: "optimized-string", src: source };
}

function applyIntrinsicSizeFromQuery(source: string) {
  const [, query] = source.split("?", 2);
  if (!query) return;

  const params = new URLSearchParams(query);
  const originalWidth = Number(params.get("origWidth"));
  const originalHeight = Number(params.get("origHeight"));
  if (!Number.isFinite(originalWidth) || !Number.isFinite(originalHeight))
    return;

  width ??= originalWidth;
  height ??= originalHeight;
}

async function readImageForPlaceholder(source: ImageSource) {
  if (source.kind === "asset") {
    return readFile(source.fsPath);
  }

  if (source.kind !== "optimized-string") return null;

  return source.src.startsWith("http")
    ? fetch(source.src).then(async (res) =>
        Buffer.from(await res.arrayBuffer()),
      )
    : readFile(new URL(source.src.replace("../", ""), import.meta.url));
}
---

<span
  zaduma-image
  style={`--zaduma-img-src: url("${attrs.src}")`}
  class:list={[
    "zaduma-image-box relative block overflow-hidden",
    !placeholder &&
      "inline-flex! w-full justify-center [&>img]:h-full [&>img]:object-contain",
  ]}
>
  <img
    {...attrs}
    class:list={["rounded-sm dark:opacity-80", attrs.class]}
    loading={loading}
    decoding={decoding}
  />
  {
    placeholder && (
      <span
        style={placeholder}
        class="absolute inset-0 -z-10 h-full w-full scale-150 transform blur-2xl filter dark:opacity-80"
      />
    )
  }
</span>
