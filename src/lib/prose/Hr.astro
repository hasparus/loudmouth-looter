---
/* Ornamental rule used for `---` in prose — a hairline broken by a centred
   floral heart, masked over the page background. */
---

<hr class="zaduma-rule" />

<style>
  @reference "../../global-styles/base.css";

  .zaduma-rule {
    border: 0;
    height: 1px;
    margin: 2.5rem 0;
    background: var(--color-neu-200);
    position: relative;
    overflow: visible;
  }

  .zaduma-rule::after {
    content: "❦";
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    padding: 0 0.75rem;
    background: var(--grain-bg);
    color: var(--color-neu-400);
    font-size: 1rem;
    line-height: 1;
  }

  :global(html.dark) .zaduma-rule {
    background: var(--color-neu-800);
  }

  :global(html.dark) .zaduma-rule::after {
    color: var(--color-neu-500);
  }
</style>
