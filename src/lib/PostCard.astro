---
import { Link } from "./Link";
import { mdxComponents } from "./mdxComponents";
import type { PostEntry } from "./posts";
import { tagSlug } from "./posts";
import PostSigil from "./PostSigil.astro";
import PostTime from "./PostTime.astro";
import ReadMore from "./ReadMore.astro";

interface Props {
  post: PostEntry;
  class?: string;
}

const { post, class: className } = Astro.props;
const { frontmatter, Excerpt, sigil } = post;
const date = new Date(frontmatter.date);
---

<article class:list={["group relative", className]}>
  <a
    href={frontmatter.path}
    aria-label={frontmatter.title}
    class="focus-visible:outline-neu-400 absolute inset-0 z-0 rounded-lg no-underline hover:bg-none focus-visible:outline-2 focus-visible:outline-offset-2"
  ></a>
  {sigil && <PostSigil sigil={sigil} />}
  <PostTime
    date={date}
    class="group-link-hocus:text-accent-700 dark:group-link-hocus:text-accent-400 relative z-10 cursor-pointer"
    href={frontmatter.path}
  />
  <div class="pointer-events-none relative z-10 mt-1 flex flex-col gap-3">
    <h2
      class="text-neu-800 group-link-hocus:text-neu-950 dark:text-neu-300 dark:group-link-hocus:text-neu-100 mt-1 font-serif font-bold transition-colors [text-box:trim-end]"
    >
      {frontmatter.title}
    </h2>

    {
      Excerpt && (
        <div class="zaduma-prose zaduma-excerpt text-neu-600 dark:text-neu-400 max-w-none">
          <Excerpt components={mdxComponents} />
        </div>
      )
    }

    <div class="flex items-center gap-4">
      {
        frontmatter.tags?.length ? (
          <ul class="flex flex-wrap gap-x-4 gap-y-1">
            {frontmatter.tags.map((tag) => (
              <li>
                <Link
                  href={`/tags/${tagSlug(tag)}`}
                  noUnderline
                  class="font-text text-neu-600 hover:text-neu-900 dark:text-neu-500 dark:hover:text-neu-200 dark:focus-visible:text-neu-200 focus-visible:text-neu-900 pointer-events-auto text-base tracking-wide lowercase italic"
                >
                  § {tag}
                </Link>
              </li>
            ))}
          </ul>
        ) : null
      }
      <ReadMore href={frontmatter.path} class="ml-auto shrink-0 text-base" />
    </div>
  </div>
</article>
