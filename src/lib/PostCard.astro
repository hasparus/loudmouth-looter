---
import { mdxComponents } from "./mdxComponents";
import type { PostEntry } from "./posts";
import { tagSlug } from "./posts";
import PostTime from "./PostTime.astro";
import ReadMore from "./ReadMore.astro";

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const { frontmatter, Excerpt, sigil } = post;
const date = new Date(frontmatter.date);
---

<article class="group relative py-8">
  <a
    href={frontmatter.path}
    aria-label={frontmatter.title}
    class="focus-visible:outline-neu-400 absolute inset-0 z-0 rounded-lg no-underline hover:bg-none focus-visible:outline-2 focus-visible:outline-offset-2"
  ></a>
  {
    sigil && (
      <span
        aria-hidden="true"
        set:html={sigil}
        class="pointer-events-none absolute top-11 -left-10 z-10 hidden font-serif text-3xl leading-none text-red-800 select-none md:block lg:-left-12 dark:text-red-400 [&_svg]:h-[1.1em] [&_svg]:w-auto"
      />
    )
  }
  <PostTime
    date={date}
    class="relative z-10 cursor-pointer group-hover:text-red-700 dark:group-hover:text-red-400 [.group:has(:focus-visible)_&]:text-red-700 dark:[.group:has(:focus-visible)_&]:text-red-400"
    onclick={`location.href='${frontmatter.path}'`}
  />
  <div class="pointer-events-none relative z-10 flex flex-col gap-3">
    <h2
      class="text-neu-800 group-focus-visible:text-neu-950 group-hover:text-neu-950 dark:text-neu-300 dark:group-hover:text-neu-100 mt-1 font-serif font-bold transition-colors [text-box:trim-end]"
    >
      {frontmatter.title}
    </h2>

    {
      Excerpt && (
        <div class="zaduma-prose zaduma-excerpt text-neu-600 dark:text-neu-400 max-w-none">
          <Excerpt components={mdxComponents} />
        </div>
      )
    }

    <div class="mt-1 flex items-center gap-4">
      {
        frontmatter.tags?.length ? (
          <ul class="flex flex-wrap gap-x-4 gap-y-1">
            {frontmatter.tags.map((tag) => (
              <li>
                <a
                  href={`/tags/${tagSlug(tag)}`}
                  class="font-text text-neu-600 hover:text-neu-900 dark:text-neu-500 dark:hover:text-neu-200 dark:focus-visible:text-neu-200 focus-visible:text-neu-900 pointer-events-auto text-sm tracking-wide lowercase italic no-underline"
                >
                  § {tag}
                </a>
              </li>
            ))}
          </ul>
        ) : null
      }
      <ReadMore href={frontmatter.path} class="ml-auto shrink-0 text-base" />
    </div>
  </div>
</article>
