---
// Render-side counterpart to the editor's <Move> card. The moveCardPlugin
// (build-time) lifts the wrapped heading into `title` / `id`, so here the title
// is the card's heading and the id its anchor; the rest of the move is slotted.
// Renders dungeon-motion's MoveCard verbatim so published cards match the main
// compendium. A no-heading Move (no title) falls back to a bare .te-move block.
import "../editor-atoms.css";
import { MoveCard } from "../move-card";

interface Props {
  title?: string;
  id?: string;
}

const { title, id } = Astro.props;
---

{
  title ? (
    <MoveCard title={title} id={id}>
      <slot />
    </MoveCard>
  ) : (
    <article class="te-move">
      <slot />
    </article>
  )
}
