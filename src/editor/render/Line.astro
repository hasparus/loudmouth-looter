---
// Render-side counterpart to the editor's <Line> atom. Matches editor-mdx.ts's
// lineToDom output (<p class="te-arrow|te-chevron">…</p>) so the marker line
// styles in editor-atoms.css apply identically to published posts.
import "../editor-atoms.css";

interface Props {
  kind?: "arrow" | "chevron";
}

const { kind = "arrow" } = Astro.props;
---

<p class={kind === "chevron" ? "te-chevron" : "te-arrow"}><slot /></p>
