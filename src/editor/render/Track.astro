---
// Render-side counterpart to the editor's <Track> atom. Produces the exact same
// inert markup as editor-atoms.tsx's <TrackPreview> (aria-hidden span of
// te-toggle spans) so the shared editor-atoms.css styles published posts and the
// editor identically — the single CSS source of truth for atom render-parity.
import "../editor-atoms.css";

type Shape = "circle" | "rhomb" | "square";

interface Props {
  shape?: Shape;
  filled?: number | string;
  total?: number | string;
}

const SHAPES: ReadonlySet<string> = new Set(["circle", "rhomb", "square"]);
const MAX = 12;
const clamp = (v: number) =>
  Number.isFinite(v) ? Math.min(Math.max(Math.trunc(v), 1), MAX) : 1;

const { shape: rawShape, filled: rawFilled, total: rawTotal } = Astro.props;
const shape: Shape = SHAPES.has(rawShape as string)
  ? (rawShape as Shape)
  : "square";
const total = clamp(Number(rawTotal) || 1);
const filled = Math.min(Math.max(Number(rawFilled) || 0, 0), total);
---

<span aria-hidden="true" class="te-track" data-preview="1">
  {
    Array.from({ length: total }, (_, i) => (
      <span
        aria-checked={i < filled ? "true" : "false"}
        class="te-toggle"
        data-shape={shape}
      />
    ))
  }
</span>
