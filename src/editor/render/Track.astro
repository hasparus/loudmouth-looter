---
// Render-side counterpart to the editor's <Track> atom. Two variants:
// - value (controlled): inert aria-hidden spans, same as editor TrackPreview.
// - defaultValue (uncontrolled): real buttons with click delegation via a
//   module script so the published track is interactive.
import { Show } from "solid-js";

import { resolveTrackProps } from "../track-props";

import "../editor-atoms.css";

interface Props {
  shape?: string;
  /** Controlled fill count — renders inert (static). */
  value?: number | string;
  /** Uncontrolled initial fill count — renders interactive (clickable). */
  defaultValue?: number | string;
  /** Toggle count. */
  max?: number | string;
  name?: string;
  class?: string;
  style?: string | Record<string, string>;
}

const {
  shape,
  fill,
  max: maxVal,
  interactive,
  name,
} = resolveTrackProps(Astro.props);
const className = Astro.props.class;
const style = Astro.props.style;
---

{
  interactive ? (
    <span class:list={["te-track", className]} style={style}>
      <Show when={name}>
        <span class="text-neu-600 dark:text-neu-300 trim-end-alphabetic mr-2 font-serif text-sm font-black">
          {name}
        </span>
      </Show>
      {Array.from({ length: maxVal }, (_, i) => (
        <button
          type="button"
          class="te-toggle"
          data-shape={shape}
          role="checkbox"
          aria-checked={i < fill ? "true" : "false"}
          aria-label={shape}
        />
      ))}
    </span>
  ) : (
    <span aria-hidden="true" class:list={["te-track", className]} style={style} data-preview="1">
      <Show when={name}>
        <span class="text-neu-600 dark:text-neu-300 trim-end-alphabetic mr-2 font-serif text-sm font-black">
          {name}
        </span>
      </Show>
      {Array.from({ length: maxVal }, (_, i) => (
        <span
          aria-checked={i < fill ? "true" : "false"}
          class="te-toggle"
          data-shape={shape}
        />
      ))}
    </span>
  )
}

<script>
  // Module script — Astro deduplicates this across all Track instances.
  // Cumulative fill: clicking box i marks 1..i; clicking the topmost marked
  // box clears it. Tracks are progress meters, not independent checkboxes.
  document.addEventListener("click", (e) => {
    if (!(e.target instanceof Element)) return;
    const toggle = e.target.closest<HTMLElement>(
      ".te-track:not([data-preview]) > .te-toggle",
    );
    if (!toggle?.parentElement) return;
    const toggles = [
      ...toggle.parentElement.querySelectorAll<HTMLElement>(
        ":scope > .te-toggle",
      ),
    ];
    const i = toggles.indexOf(toggle);
    const isChecked = (el: HTMLElement | undefined) =>
      el?.getAttribute("aria-checked") === "true";
    const isTop = isChecked(toggle) && !isChecked(toggles[i + 1]);
    const fill = isTop ? i : i + 1;
    toggles.forEach((t, j) =>
      t.setAttribute("aria-checked", j < fill ? "true" : "false"),
    );
  });
</script>
