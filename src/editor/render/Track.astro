---
// Render-side counterpart to the editor's <Track> atom. Two variants:
// - value (controlled): inert aria-hidden spans, same as editor TrackPreview.
// - defaultValue (uncontrolled): real buttons with click delegation via a
//   module script so the published track is interactive.
import { resolveTrackProps } from "../track-props";

import "../editor-atoms.css";

interface Props {
  shape?: string;
  /** Controlled fill count — renders inert (static). */
  value?: number | string;
  /** Uncontrolled initial fill count — renders interactive (clickable). */
  defaultValue?: number | string;
  /** Toggle count. Aliases: total (legacy). */
  max?: number | string;
  /** Legacy alias for max. */
  total?: number | string;
  /** Legacy alias for value. */
  filled?: number | string;
}

const {
  shape,
  fill,
  max: maxVal,
  interactive: isInteractive,
} = resolveTrackProps(Astro.props);
---

{
  isInteractive ? (
    <span class="te-track">
      {Array.from({ length: maxVal }, (_, i) => (
        <button
          type="button"
          class="te-toggle"
          data-shape={shape}
          role="checkbox"
          aria-checked={i < fill ? "true" : "false"}
          aria-label={shape}
        />
      ))}
    </span>
  ) : (
    <span aria-hidden="true" class="te-track" data-preview="1">
      {Array.from({ length: maxVal }, (_, i) => (
        <span
          aria-checked={i < fill ? "true" : "false"}
          class="te-toggle"
          data-shape={shape}
        />
      ))}
    </span>
  )
}

<script>
  // Module script — Astro deduplicates this across all Track instances.
  // Delegation handles click on any interactive track toggle on the page.
  document.addEventListener("click", (e) => {
    if (!(e.target instanceof Element)) return;
    const toggle = e.target.closest<HTMLElement>(
      ".te-track:not([data-preview]) > .te-toggle",
    );
    if (!toggle) return;
    const checked = toggle.getAttribute("aria-checked") === "true";
    toggle.setAttribute("aria-checked", checked ? "false" : "true");
  });
</script>
