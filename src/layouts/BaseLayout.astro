---
import crimsonItalicPath from "@fontsource/crimson-text/files/crimson-text-latin-400-italic.woff2";
import crimsonPath from "@fontsource/crimson-text/files/crimson-text-latin-400-normal.woff2";
import Analytics from "@vercel/analytics/astro";

import InitColorScheme from "../lib/color-scheme/InitColorScheme.astro";
import { Commands } from "../lib/Commands";
import CursorParty from "../lib/CursorParty.astro";
import { isPostVisible } from "../lib/isPostVisible";
import { Link } from "../lib/Link";
import Marginalia from "../lib/Marginalia.astro";
import ScrollbarStyles from "../lib/ScrollbarStyles.astro";
import { websiteSchema } from "../lib/seo/jsonLd";
import JsonLd from "../lib/seo/JsonLd.astro";
import { SITE_NAME } from "../lib/siteMeta";
import SocialCardMetaTags from "../lib/SocialCardMetaTags.astro";
import type { PostFrontmatter } from "../types";

import "../global-styles/base.css";
import "../global-styles/controls.css";
import "../global-styles/cursors.css";
import "../global-styles/integrations.css";
import "../lib/prose/prose.css";

interface Props {
  title: string;
  description: string;
  children: astroHTML.JSX.Element;
  ogImage?: string;
  /** Live multiplayer cursors. On by default; opt out per page (e.g. admin). */
  cursors?: boolean;
}

const { title, description, ogImage, cursors = true } = Astro.props;

const postModules = import.meta.glob<{ frontmatter: PostFrontmatter }>(
  "../../posts/**/*.mdx",
  { eager: true },
);
const posts = Object.values(postModules)
  .filter((p) => isPostVisible(p.frontmatter, { isProd: import.meta.env.PROD }))
  .map((p) => ({
    href: p.frontmatter.path,
    title: p.frontmatter.title,
    date: p.frontmatter.date,
  }))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const postPaths = new Set(posts.map((p) => p.href));

// Normalize trailing slash before lookup
const rawPathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isPostRoute = postPaths.has(rawPathname);

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;

const markdownAlt = Astro.site
  ? new URL(rawPathname + ".md", Astro.site).href
  : rawPathname + ".md";

const websiteData = websiteSchema({
  name: SITE_NAME,
  url: Astro.site ? Astro.site.href : Astro.url.origin + "/",
});

// Pages that supply their own header content (home, tags) render a title in
// the content header. The rest (posts) get a floating back link mirroring the
// Commands trigger in the opposite top corner.
const hasHeaderContent = Astro.slots.has("header-content");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {
      [crimsonPath, crimsonItalicPath].map((href) => (
        <link
          rel="preload"
          href={href}
          as="font"
          type="font/woff2"
          crossorigin
        />
      ))
    }
    <link
      rel="preload"
      href="/fonts/Avara-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Avara-Black.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      /* Cursor images are lazy-fetched by browsers, so the default + pointer
         cursors flash the system cursor on load and when re-entering the
         window. Preload the always-on ones (DPR-matched). */
      ["default", "pointer", "pointer-active"].map((name) => (
        <link
          rel="preload"
          as="image"
          href={`/cursors/${name}.png`}
          imagesrcset={`/cursors/${name}.png 1x, /cursors/${name}@2x.png 2x`}
        />
      ))
    }

    <SocialCardMetaTags
      title={title}
      description={description}
      ogImage={ogImage}
    />

    <link rel="canonical" href={canonical} />
    {
      isPostRoute && (
        <link rel="alternate" type="text/markdown" href={markdownAlt} />
      )
    }

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    <JsonLd data={websiteData} />
    <slot name="head" />
    <InitColorScheme />
  </head>
  <body>
    <Commands
      client:idle
      posts={posts}
      class="absolute! top-2 right-1.5 z-50 sm:top-4 sm:right-4 xl:top-8 xl:right-8"
    />
    {
      !hasHeaderContent && (
        <Link
          href="/"
          class="absolute! top-2 left-1.5 z-50 opacity-80 sm:top-4 sm:left-4 xl:top-8 xl:left-8"
        >
          ← back
        </Link>
      )
    }
    <main>
      <div class="max-w-container mx-auto px-4">
        <header class="flex items-center" style={{ height: "37.5px" }}>
          <slot name="header-content" />
        </header>
        <slot />
      </div>
      <ScrollbarStyles />
      {cursors && <CursorParty />}
      <Marginalia />
    </main>

    <Analytics />

    <script>
      // Show the pointer-active (pinched) cursor the instant a clickable is
      // pressed. CSS :active is late: the browser only repaints the cursor on
      // the next pointer move, so a press without moving doesn't swap. Mutating
      // an attribute on the element under the pointer forces an immediate
      // recompute. CSS handles the rest via [data-cursor-pressed].
      // Keep this list in sync with the clickable selector in cursors.css.
      const SELECTOR =
        'a[href],button,summary,label,select,input[type="button"],input[type="checkbox"],input[type="color"],input[type="file"],input[type="radio"],input[type="range"],input[type="reset"],input[type="submit"],[role="button"],[role="checkbox"],[role="link"],[role="menuitem"],[role="option"],[role="radio"],[role="slider"],[role="switch"],[role="tab"],[onclick]';

      let held: Element | null = null;
      const clear = () => {
        held?.removeAttribute("data-cursor-pressed");
        held = null;
      };

      addEventListener(
        "pointerdown",
        (e) => {
          const target = e.target;
          const el =
            target instanceof Element ? target.closest(SELECTOR) : null;
          if (!el || el.matches(':disabled,[aria-disabled="true"]')) return;
          held = el;
          el.setAttribute("data-cursor-pressed", "");
        },
        true,
      );
      addEventListener("pointerup", clear, true);
      addEventListener("pointercancel", clear, true);
      addEventListener("dragend", clear, true);
    </script>
  </body>
</html>
