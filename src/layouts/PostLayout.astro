---
import type { MarkdownHeading, MDXInstance } from "astro";

import { resolvePostOgImage } from "../lib/ogImage";
import { normalizeImg } from "../lib/postImages";
import PostTime from "../lib/PostTime.astro";
import Image from "../lib/prose/Image.astro";
import { blogPostingSchema } from "../lib/seo/jsonLd";
import JsonLd from "../lib/seo/JsonLd.astro";
import TableOfContents from "../lib/TableOfContents/TableOfContents.astro";
import type { PostFrontmatter } from "../types";

import BaseLayout from "./BaseLayout.astro";

import "../global-styles/shiki.css";

interface Props extends Omit<MDXInstance<{}>, "frontmatter"> {
  frontmatter: PostFrontmatter;
  headings: MarkdownHeading[];
}

const { frontmatter, headings } = Astro.props;

const ogImage = await resolvePostOgImage(frontmatter, Astro.props.file);
const readingTime = frontmatter.readingTime;
const date = new Date(frontmatter.date);
const imgSrc = normalizeImg(frontmatter.img).src;
const description = frontmatter.description || "";

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;

// TODO(downstream): set author (Person/Organization) per site.
const postSchema = blogPostingSchema({
  headline: frontmatter.title,
  datePublished: date.toISOString(),
  description: frontmatter.description,
  canonical,
});
---

<BaseLayout
  title={frontmatter.title}
  ogImage={ogImage}
  description={description}
  ogType="article"
>
  <JsonLd data={postSchema} slot="head" />
  <div class="zaduma-prose zaduma-prose-grid py-4">
    <header>
      <div
        class="text-neu-600 dark:text-neu-400 flex items-center justify-between"
      >
        {
          readingTime.minutes > 1 && (
            <span class="all-small-caps text-neu-500 h-[1.5cap] shrink-0 text-sm font-medium tracking-wide tabular-nums">
              {readingTime.text}
            </span>
          )
        }
        <PostTime date={date} />
      </div>
      <h1 class="mt-2 font-serif text-3xl font-bold">{frontmatter.title}</h1>
    </header>
    {
      imgSrc && (
        <Image
          alt=""
          src={imgSrc}
          format="webp"
          width={774}
          height={387}
          relativeTo={Astro.props.file}
        />
      )
    }
    <slot />
  </div>
  <TableOfContents headings={headings} />
</BaseLayout>
