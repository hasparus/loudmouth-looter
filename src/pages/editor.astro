---
// Standalone editor page (own <html>, no site chrome) — mirrors dungeon-motion's
// editor.astro. The editor is a Solid island (client:only); the slotted markup
// is the pre-hydration skeleton. Skin + Tailwind utilities come from
// editor-skin.css, imported here so they load only on this route.
// Avara (display face) is self-hosted from public/fonts under the SIL OFL 1.1
// (Raphaël Bastide / Velvetyne, see public/fonts/Avara-OFL.txt) and preloaded.
// Crimson Text (body face, 400/600 only) is preloaded below for editor body text.
import crimson400 from "@fontsource/crimson-text/files/crimson-text-latin-400-normal.woff2?url";
import crimson600 from "@fontsource/crimson-text/files/crimson-text-latin-600-normal.woff2?url";

import { TextEditor } from "../editor/text-editor";
import InitColorScheme from "../lib/color-scheme/InitColorScheme.astro";

import "../editor/editor-skin.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="theme-color"
      content="#fafaf9"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#1c1917"
      media="(prefers-color-scheme: dark)"
    />
    <title>editor — loudmouth looter</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/Avara-Black.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Avara-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={crimson400}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={crimson600}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <InitColorScheme />
  </head>
  <body class="m-0">
    <TextEditor client:only="solid-js">
      <main class="min-h-screen">
        <div class="mx-auto max-w-3xl animate-pulse px-4 py-24 md:px-6">
          <div class="bg-neu-200 dark:bg-neu-800 mb-4 h-8 w-2/3 rounded"></div>
          <div class="bg-neu-200 dark:bg-neu-800 mb-3 h-4 w-full rounded"></div>
          <div class="bg-neu-200 dark:bg-neu-800 mb-6 h-4 w-5/6 rounded"></div>
          <div class="bg-neu-200 dark:bg-neu-800 mb-3 h-6 w-1/2 rounded"></div>
          <div class="bg-neu-200 dark:bg-neu-800 mb-3 h-4 w-full rounded"></div>
          <div class="bg-neu-200 dark:bg-neu-800 h-4 w-4/5 rounded"></div>
        </div>
      </main>
    </TextEditor>
  </body>
</html>

<style>
  @media print {
    @page {
      size: A4 portrait;
      margin: 12mm;
    }
  }
</style>
