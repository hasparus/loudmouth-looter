---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Link } from "../lib/Link";
import { resolvePostOgImage } from "../lib/ogImage";
import type { PostFrontmatter } from "../types";

const postModules = import.meta.glob<{ frontmatter: PostFrontmatter }>(
  "../../posts/**/*.mdx",
  { eager: true },
);

const linksToOGImages = await Promise.all(
  Object.entries(postModules).map(([file, post]) =>
    resolvePostOgImage(post.frontmatter, file),
  ),
);
---

<BaseLayout
  title="admin"
  description="a page for inspecting and debugging OG images"
  cursors={false}
>
  <section class="py-10">
    <h1>OG Images</h1>
    <ul class="flex flex-col">
      {
        linksToOGImages.map((href) => (
          <li class="w-full">
            <Link
              href={href}
              noUnderline
              class="mx-0 my-0 flex w-full flex-row gap-2 text-sm break-all"
            >
              <span>{href}</span>
              <img
                width="320px"
                height="160px"
                class="border-neu-600 h-[160px] w-[320px] border"
                src={href}
              />
            </Link>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
