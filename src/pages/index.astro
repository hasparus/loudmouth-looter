---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Link } from "../lib/Link";
import PostCard from "../lib/PostCard.astro";
import { getPosts } from "../lib/posts";
import { Paragraph } from "../lib/prose/Paragraph";
import { SITE_BLURB, SITE_NAME } from "../lib/siteMeta";

const posts = await getPosts();
---

<BaseLayout title={SITE_NAME} description={SITE_BLURB}>
  <h1
    slot="header-content"
    class="font-serif font-bold tracking-tighter text-stone-600 dark:text-stone-500"
  >
    {SITE_NAME}
  </h1>

  <main class="zaduma-prose py-10">
    <Paragraph
      >This is an archive of my edgy and opinionated alter ego.
    </Paragraph>
    <aside>
      <span class="font-hand">~Piotr</span>
    </aside>
  </main>

  <ul>
    {
      posts.map((post) => (
        <li>
          <PostCard post={post} />
        </li>
      ))
    }
  </ul>
</BaseLayout>
