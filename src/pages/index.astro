---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Dialogue } from "../lib/Dialogue";
import introSrc from "../lib/intro.tree?raw";
import PostCard from "../lib/PostCard.astro";
import { getPosts } from "../lib/posts";
import { SITE_BLURB, SITE_NAME } from "../lib/siteMeta";
import { parse } from "../lib/tree";

const posts = getPosts();
const introTree = parse(introSrc);
---

<BaseLayout title={SITE_NAME} description={SITE_BLURB}>
  <h1
    slot="header-content"
    class="font-serif font-bold tracking-tighter text-neu-600 dark:text-neu-500"
  >
    {SITE_NAME}
  </h1>

  <main class="zaduma-prose py-10">
    <Dialogue tree={introTree} client:idle />
  </main>

  <ul>
    {
      posts.map((post) => (
        <li>
          <PostCard post={post} />
        </li>
      ))
    }
  </ul>
</BaseLayout>
