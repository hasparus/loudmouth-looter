---
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDate } from "../lib/formatDate";
import { isPostVisible } from "../lib/isPostVisible";
import { Link } from "../lib/Link";
import { Paragraph } from "../lib/prose/Paragraph";
import { SITE_BLURB, SITE_NAME } from "../lib/siteMeta";
import type { PostFrontmatter } from "../types";

const postModules = import.meta.glob<{ frontmatter: PostFrontmatter }>(
  "../../posts/**/*.mdx",
  { eager: true },
);
const posts = Object.values(postModules).filter((post) =>
  isPostVisible(post.frontmatter, { isProd: import.meta.env.PROD }),
);

posts.sort((a, b) => {
  return (
    new Date(b.frontmatter.date).getTime() -
    new Date(a.frontmatter.date).getTime()
  );
});
---

<BaseLayout title={SITE_NAME} description={SITE_BLURB}>
  <h1
    slot="header-content"
    class="font-serif font-bold text-stone-600 dark:text-stone-500"
  >
    {SITE_NAME}
  </h1>
  <main class="zaduma-prose py-10">
    <Paragraph>
      Posts drafted in the <Link href="/editor">editor</Link> — built on{" "}
      <Link href="https://github.com/hasparus/zaduma">zaduma</Link>.
    </Paragraph>
  </main>
  <ul>
    {
      posts.map(({ frontmatter }) => {
        const date = new Date(frontmatter.date);

        return (
          <li>
            <Link
              href={frontmatter.path}
              class="flex flex-row justify-between gap-2"
              noUnderline
            >
              <h2 class="font-serif text-stone-800 dark:text-stone-300">
                {frontmatter.title}
              </h2>
              <time
                datetime={date.toISOString()}
                class="shrink-0 tracking-tighter text-stone-600 tabular-nums dark:text-stone-400"
              >
                {formatDate(date)}
              </time>
            </Link>
          </li>
        );
      })
    }
  </ul>
  <style>
    @reference "../global-styles/base.css";

    ul:hover li:not(:hover) :where(h2, time) {
      color: var(--color-stone-600);
      transition: color 150ms;

      :global(.dark) & {
        color: var(--color-stone-500);
      }
    }
  </style>
</BaseLayout>
