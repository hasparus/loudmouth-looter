---
import BaseLayout from "../layouts/BaseLayout.astro";
import DialogueIntro from "../lib/DialogueIntro.astro";
import PostCard from "../lib/PostCard.astro";
import { getPosts } from "../lib/posts";
import { SITE_BLURB, SITE_NAME } from "../lib/siteMeta";
import { talks } from "../talks/talks";

const entries = [...getPosts(), ...talks].sort(
  (a, b) =>
    new Date(b.frontmatter.date).getTime() -
    new Date(a.frontmatter.date).getTime(),
);
---

<BaseLayout title={SITE_NAME} description={SITE_BLURB}>
  <h1
    slot="header-content"
    class="text-neu-600 dark:text-neu-300 font-serif font-bold tracking-tighter"
  >
    {SITE_NAME}
  </h1>

  <div class="zaduma-prose py-10">
    <DialogueIntro />
  </div>

  <ul class="-my-4">
    {
      entries.map((entry) => (
        <li>
          <PostCard post={entry} class="-mx-4 p-4 pt-2" />
        </li>
      ))
    }
  </ul>
</BaseLayout>
