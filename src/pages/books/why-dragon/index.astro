---
/* eslint-disable better-tailwindcss/no-unknown-classes */
import InitColorScheme from "../../../lib/color-scheme/InitColorScheme.astro";

import Move from "./_Move.astro";
import dragonUrl from "./dragon.webp?url";
import fireUrl from "./fire.webp?url";
import pyre1 from "./pyre-1.webp?url";
import pyre2 from "./pyre-2.webp?url";
import pyre3 from "./pyre-3.webp?url";
import pyre4 from "./pyre-4.webp?url";

import "../../../global-styles/base.css";
import "./why-dragon.css";

const pyreLevels = [
  { src: pyre1, top: 94.5, h: 48 },
  { src: pyre2, top: 81.5, h: 48 },
  { src: pyre3, top: 52.9, h: 62 },
  { src: pyre4, top: 27.2, h: 65 },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Why Would You Fight a Dragon? — printable</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <InitColorScheme />
  </head>
  <body>
    <div class="wd-book">
      <div class="wd-sheet">
        <article class="wd-page wd-verso wd-hunter">
          <span class="wd-pageno">4 · hunter</span>
          <h2 class="wd-full wd-hunter-title">
            Hunter
            <span class="wd-hunter-booktitle"
              >Why Would You Fight a Dragon?</span
            >
          </h2>
          <section class="wd-pyre wd-span-2" style="grid-row: span 4">
            <h3 class="wd-rubric">Pyre</h3>
            <div
              class="wd-pyre-visual"
              role="img"
              aria-label="Pyre track, four levels from base to tip"
            >
              <img class="wd-pyre-img" src={fireUrl} alt="" />
              {
                pyreLevels.map(({ src, top, h }) => (
                  <>
                    <div class="wd-pyre-tick" style={`top: ${top}%`} />
                    <img
                      class="wd-pyre-num"
                      src={src}
                      alt=""
                      style={`top: ${top}%; block-size: ${((h / 1332) * 100).toFixed(2)}%`}
                    />
                  </>
                ))
              }
            </div>
            <p class="wd-hint">
              Mark circles or slide a paperclip. <br />Fill four and you're <strong
                >consumed</strong
              >.
            </p>
          </section>
          <section class="wd-span-4 wd-fields">
            <div class="wd-field">
              <span class="wd-field-name">Name</span>
              <span class="wd-line"></span>
              <span class="wd-examples wd-stat-desc italic">
                e.g. Sigurd, Vanda, Skuba, Bastian, Fleur, Martha, Wulf, Maud,
                Juro, Orm
              </span>
            </div>
            <div class="wd-field">
              <span class="wd-field-name">Class</span>
              <span class="wd-line"></span>
              <label class="wd-bellow">
                <input type="checkbox" />
                <span>Bellow</span>
              </label>
              <span class="wd-examples wd-stat-desc italic">
                e.g. Knight, King, Bowman, Wizard, Maiden, Mutant, Trickster,
                Saint
              </span>
            </div>
            <div class="wd-field">
              <span class="wd-field-name">Look</span>
              <span class="wd-line"></span>
              <span class="wd-examples wd-stat-desc italic">
                e.g. radiant, fair, pale, gaunt, scarred, sooty, grim, old,
                white hair, wild eyes
              </span>
            </div>
          </section>
          <section class="wd-span-4">
            <h3 class="wd-rubric">Stats</h3>
            <div class="h-[1.5mm]"></div>
            {
              [
                ["Body", "physical strength and stamina"],
                ["Wits", "mental acuity and perception"],
                ["Soul", "arcane potency and spiritual force"],
              ].map(([stat, meaning]) => (
                <div class="wd-stat-row">
                  <span class="wd-stat-name">{stat}</span>
                  <span class="wd-stat-desc italic">({meaning})</span>
                  <span class="wd-stat-slot" />
                </div>
              ))
            }
            <p class="wd-hint">
              Distribute −2 to +2 so the total equals +1:<br />
              (+2, 0, −1) (+1, +1, −1) (+1, 0, 0) (+2, +1, −2)
            </p>
          </section>
          <section class="wd-span-2">
            <h3 class="wd-rubric">Goal</h3>
            <ul class="wd-goal-list">
              {
                [
                  "Glory",
                  "Greed",
                  "Knowledge",
                  "Love",
                  "Oath",
                  "Power",
                  "Vengeance",
                ].map((goal) => (
                  <li>
                    <input type="checkbox" /> {goal}
                  </li>
                ))
              }
              <li><input type="checkbox" /> <span class="wd-line"></span></li>
            </ul>
          </section>
          <section class="wd-span-2 wd-notes">
            <span class="wd-rose" aria-hidden="true">❦</span>
            <h3 class="wd-rubric">Notes</h3>
          </section>
          <section class="wd-span-4">
            <div class="wd-xp-head">
              <h3 class="wd-rubric">XP</h3>
              {[1, 2, 3, 4].map(() => <input type="checkbox" />)}
            </div>
            <p class="wd-hint">
              Mark 1 XP when you roll a 6−, or your Goal leads you into danger. <br
              />
              4 XP and a moment of rest: raise a stat by +1 (up to +3) or clear 1
              Pyre.
            </p>
          </section>
          <section class="wd-span-3 wd-howto">
            <h3 class="wd-rubric">How to Play</h3>
            <p>
              If you do it, do it in the fiction. Describe how and what it looks
              like.
            </p>
            <p>
              If it triggers a move, the DM will call it. If it fits no move,
              don't roll: it happens.
            </p>
            <p>
              When everything's on fire and the Dragon's about to eat you,
              action calls for <strong>Face Fury</strong>.
            </p>
          </section>
          <section class="wd-span-3 wd-principles">
            <h3 class="wd-rubric">Player Principles</h3>
            <ul>
              <li>Begin and end with the fiction.</li>
              <li>Bind your story to other Hunters.</li>
              <li>Be bold, take risks, embrace the fire.</li>
              <li>Pay attention, ask questions, offer suggestions.</li>
            </ul>
          </section>
        </article>

        <article class="wd-page wd-recto wd-cover">
          <span class="wd-pageno">1 · cover</span>
          <div
            class="wd-full"
            style="min-height: calc(var(--wd-baseline) * 20)"
          >
          </div>
          <h1 class="sr-only">Why Would You Fight a Dragon?</h1>
          <p class="wd-full wd-premise-zoom -mt-5! leading-none">
            a roleplaying game of violence, change, and sacrifice
            <br />
            for up to 5 people, in 2–4 hours
          </p>

          <div class="wd-premise wd-full">
            <p>Fall fearless like <span class="wd-myth">Beowulf</span>.</p>
            <p>
              Let your wants change you like <span class="wd-myth">Fáfnir</span
              >.
            </p>
            <p>
              Save a princess and blackmail townsfolk like <span class="wd-myth"
                >Saint George</span
              >.
            </p>
          </div>

          <p class="wd-colophon wd-full">
            Written by Piotr Monwid-Olechnowicz. Illustrated by Rouzeris.
            Proofread by Zack Thomson, Wafergix, Łukasz Bartoszewicz.
          </p>
          <p class="wd-colophon wd-full">
            Based on <em>1 HP Dragon</em> by Clayton Notestine. <em
              >Face Fury</em
            > adapts Jeremy Strandberg's <em>Defy Danger, Restated</em>, used
            under CC BY-SA 4.0. The ruleset is shared under CC BY-SA 4.0.
          </p>
          <div class="wd-marker wd-lower">
            <span>lol.haspar.us/why-dragon</span><span>hasparus.itch.io</span>
          </div>
        </article>
        <img
          class="wd-dragon-overlay"
          src={dragonUrl}
          alt="Dragon perched on burning spires"
        />
      </div>

      <div class="wd-sheet">
        <article class="wd-page wd-verso">
          <span class="wd-pageno">2 · moves I</span>

          <Move name="Face Fury" span="full">
            <p>
              When the <em
                >stakes are dire, danger is imminent,<br /> and you act anyway</em
              >, roll 2d6:
            </p>
            <ul>
              <li>
                <strong>+Body</strong> to endure, act fast or with finesse
              </li>
              <li>
                <strong>+Wits</strong> to apply expertise, enact a clever plan, or
                rely on senses
              </li>
              <li>
                <strong>+Soul</strong> to invoke the arcane, unleash mystical forces,
                resist esoteric energies
              </li>
            </ul>
            <p>
              <strong>On a 10+</strong>, you pull it off as well as one could
              hope.<br />
              <strong>On a 7–9</strong>, the DM will present a partial success,
              a tradeoff, or a complication.<br />
              <strong>On a 6−</strong>, mark <strong>1 XP</strong> and the DM makes
              a move.
            </p>
          </Move>

          <Move name="Bellow">
            <p>
              Once per session, when you <em
                >introduce a fact or narrative detail from your past life</em
              >, it affects the fiction immediately, no roll required. It must
              be related to your Class, not the Dragon. The DM and other players
              can ask you to adapt it.
            </p>
          </Move>

          <Move name="Stoke the Fire">
            <p>
              When you <em>chase your Goal with&nbsp;abandon</em>:<br /> Reroll a
              die, but
              <strong>raise Pyre</strong>.
            </p>
            <p>
              When your Goal <em>leads you into danger or&nbsp;costs you</em> something,
              take <strong>1 XP</strong>.
            </p>
          </Move>

          <Move name="Relinquish Your Goal">
            <p>When you <em>give up on your original motivation</em>:</p>
            <ul>
              <li>Describe why you forsake your Goal.</li>
              <li>
                You are visibly changed: the way you walk, your facial
                expression, maybe discard a symbol of your previous motivation.
              </li>
            </ul>
            <p>You may turn one of your rolls into a success now or later.</p>
          </Move>

          <Move name="Burn">
            <p>
              When you <em>wield power torn from the Dragon</em>, roll
              <strong>+Pyre</strong>.
            </p>
            <p>
              <strong>On 10+</strong>, the power obeys.<br />
              <strong>On 7–9</strong>, it works, but <strong>raise Pyre</strong
              >{" "}
              and say what else catches fire.<br />
              <strong>On 6−</strong>, you lose control. <strong
                >Raise Pyre</strong
              >, mark <strong>1 XP</strong>, and the DM makes a move.
            </p>
          </Move>

          <section class="wd-full wd-dm mt-4">
            <div>
              <h3 class="wd-rubric">DM's Agenda</h3>
              <ul>
                <li>Make the Dragon vast and terrible.</li>
                <li>Learn what they're willing to burn.</li>
                <li>See what's left when the smoke clears.</li>
              </ul>
            </div>
            <div>
              <h3 class="wd-rubric">DM Moves</h3>
              <p>
                Hurt, Raze, Capture, Separate,<br />Reveal, Bargain, Soar,
                Threaten.
              </p>
            </div>
          </section>

          <section class="wd-full wd-dragon-box mt-4">
            <h3 class="wd-rubric">The Dragon</h3>
            <p>
              The Dragon is made of <em>Scales</em> to protect, <em>Fangs</em> to
              deter attackers, and <em>Curses</em> that spell doom if it ever dies.
              Each is <em>Known</em> or <em>Secret</em> until a Hunter unveils it.
              Put them in the center of the table. For short games, use 3–5 and start
              <em>in medias res</em>; for four-hour games, add a <em>Curse</em> on
              top.
            </p>
          </section>
        </article>

        <article class="wd-page wd-recto">
          <span class="wd-pageno">3 · moves II</span>

          <Move name="Jump Into Flames">
            <p>
              When you <em
                >throw yourself in to help another Hunter after their roll</em
              >, they reroll one die, but you share the consequences. More than
              one person can jump in on the same action.
            </p>
          </Move>

          <Move name="Throw Sand">
            <p>
              When you <em>interfere with another Hunter's action</em>, Face
              Fury.<br />
              <strong>On 7+</strong> you impose −2 to their roll or diminish their
              effect. They may stop what they're doing and get 1 XP.<br />
              <strong>On 10+</strong> you also avoid the consequences.
            </p>
          </Move>

          <Move name="Turn to Ash">
            <p>
              When <em
                >one of your Stats gets to <strong>−3</strong> or lower</em
              >:<br />Set it to
              <strong>−3</strong> and <strong>raise Pyre</strong>.
            </p>
            <p>You're downed: you succumb to your wounds for the time being.</p>
          </Move>

          <Move name="Level Up">
            <p>
              When you <em
                >have <strong>4 XP</strong> or more, and a moment of rest</em
              >, spend <strong>4 XP</strong> to raise one of your stats by
              <strong>+1</strong> (up to <strong>+3</strong>) or clear
              <strong>1 Pyre</strong>.
            </p>
          </Move>

          <Move name="Aftermath" span="full" class="wd-aftermath">
            <p>When <em>the game ends</em>, go around the table.</p>
            <p>
              Take <strong>1 XP</strong> if you have defeated the Dragon.<br />
              Take <strong>1 XP</strong> if you mention something another Hunter did
              that you like, which wasn't mentioned before.
            </p>
            <p>
              For each unspent <strong>XP</strong> you hold, choose one from the following:
            </p>
            <ul>
              <li>
                <strong>Fulfill your Goal.</strong> Describe how getting what you
                wanted changes your life.
              </li>
              <li>
                <strong>Clear 1 Pyre</strong>. Time and distance heal your
                wounds.
              </li>
              <li>
                <strong>Claim a piece of the Dragon</strong> that wasn't destroyed,
                like the Dragon's adamantium scales, its hoard, or its dormant horde
                of undead.
              </li>
            </ul>
            <p>
              Choices are repeatable. If you <strong
                >Relinquished your Goal</strong
              >, describe the life you found in its place.
            </p>
            <p>Then, go around the table once again.</p>
            <p>
              If you're <strong>consumed</strong> and dead, name the legend told about
              you. If you're <strong>consumed</strong>, but alive, tell of the
              desolation you've wrought upon the world. Otherwise, for each
              marked <strong>Pyre</strong>, another Hunter describes a shadow
              over your future.
            </p>
            <p>
              The DM looks at the remaining pieces of the Dragon and narrates
              their future.
            </p>
            <p>When it's all over, for the last time, go around the table.</p>
            <p>
              Say one Wish, something that could've been handled better or
              differently, in fiction or at the table; and Highlight one thing
              you liked in the game.
            </p>
          </Move>
        </article>
      </div>

      <aside
        class="text-neu-500 dark:text-neu-400 fixed top-6 left-6 flex flex-col items-start gap-2 font-mono text-xs print:hidden"
      >
        <label
          class="text-neu-500 hover:bg-neu-200/70 hover:text-neu-900 dark:text-neu-400 dark:hover:bg-neu-800 dark:hover:text-neu-50 flex cursor-pointer items-center justify-center px-1 py-0.5 font-mono text-xs transition hover:duration-0"
        >
          <input type="checkbox" id="wd-grid" class="sr-only" />
          <span class="wd-grid-off">[grid off]</span>
          <span class="wd-grid-on">[grid on]</span>
        </label>
        <span class="px-1">fold on short edge</span>
      </aside>
    </div>
    <script>
      import {
        layoutNextLineRange,
        prepareWithSegments,
        type LayoutCursor,
      } from "@chenglou/pretext";

      const relayoutMoves = () => {
        for (const move of document.querySelectorAll<HTMLElement>(".wd-move")) {
          const copy = move.querySelector<HTMLElement>(".wd-move-copy");
          const initial = move.querySelector<HTMLElement>(".wd-initial");
          if (!copy || !initial) continue;

          const text = copy.textContent?.replace(/\s+/g, " ").trim();
          if (!text) continue;

          const cs = getComputedStyle(copy);
          const size = parseFloat(cs.fontSize);
          const lineHeight = parseFloat(cs.lineHeight) || size * 1.24;
          const font = `${cs.fontWeight} ${size}px ${cs.fontFamily}`;
          const prepared = prepareWithSegments(text, font);
          const initialWidth =
            initial.getBoundingClientRect().width +
            parseFloat(getComputedStyle(initial).marginRight || "0");
          const initialHeight =
            initial.getBoundingClientRect().height +
            parseFloat(getComputedStyle(initial).marginBottom || "0");
          const width = move.clientWidth;
          if (!width) continue;

          let cursor: LayoutCursor = { segmentIndex: 0, graphemeIndex: 0 };
          let y = 0;
          while (y < 2000) {
            const wrapsInitial = y < initialHeight;
            const available = wrapsInitial ? width - initialWidth : width;
            const range = layoutNextLineRange(prepared, cursor, available);
            if (range === null) break;
            cursor = range.end;
            y += lineHeight;
          }

          move.style.setProperty(
            "--wd-pretext-min-height",
            `${Math.max(initialHeight, y)}px`,
          );
        }
      };

      if (document.fonts.status === "loaded") relayoutMoves();
      else void document.fonts.ready.then(relayoutMoves);

      new ResizeObserver(relayoutMoves).observe(document.body);
    </script>
  </body>
</html>
