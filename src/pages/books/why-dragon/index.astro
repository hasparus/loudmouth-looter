---
/* eslint-disable better-tailwindcss/no-unknown-classes */
import InitColorScheme from "../../../lib/color-scheme/InitColorScheme.astro";

import * as Aftermath from "../../../rules/why-dragon/aftermath.mdx";
import * as RaiseAToast from "../../../rules/why-dragon/raise-a-toast.mdx";
import * as Bellow from "../../../rules/why-dragon/bellow.mdx";
import * as Burn from "../../../rules/why-dragon/burn.mdx";
import * as FaceFury from "../../../rules/why-dragon/face-fury.mdx";
import * as JumpIntoFlames from "../../../rules/why-dragon/jump-into-flames.mdx";
import * as LevelUp from "../../../rules/why-dragon/level-up.mdx";
import * as RelinquishYourGoal from "../../../rules/why-dragon/relinquish-your-goal.mdx";
import * as StokeTheFire from "../../../rules/why-dragon/stoke-the-fire.mdx";
import * as TheDragon from "../../../rules/why-dragon/the-dragon.mdx";
import * as ThrowSand from "../../../rules/why-dragon/throw-sand.mdx";
import * as TurnToAsh from "../../../rules/why-dragon/turn-to-ash.mdx";

import HunterPage from "./_HunterPage.astro";
import { PrintMove } from "./_PrintMove";
import dragonUrl from "./dragon.webp?url";
import swordUrl from "./dragonsword.png?url";

import "../../../global-styles/base.css";
import "./why-dragon.css";

const title = (rule: { frontmatter: Record<string, unknown> }): string => {
  const value = rule.frontmatter.title;
  if (typeof value !== "string")
    throw new Error(`rule MDX is missing a title: ${JSON.stringify(rule)}`);
  return value;
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Why Would You Fight a Dragon? — printable</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <InitColorScheme />
  </head>
  <body>
    <div class="wd-book">
      <div class="wd-sheet wd-booklet">
        <HunterPage />

        <article class="wd-page wd-recto wd-cover">
          <span class="wd-pageno">1 · cover</span>
          <div
            class="wd-full"
            style="min-height: calc(var(--wd-baseline) * 20)"
          >
          </div>
          <h1 class="sr-only">Why Would You Fight a Dragon?</h1>
          <p class="wd-full wd-premise-zoom -mt-5! leading-none">
            a roleplaying game of violence, change, and sacrifice
            <br />
            for up to 5 people, in 2–4 hours
          </p>

          <div class="wd-premise wd-full">
            <p>Fall fearless like <span class="wd-myth">Beowulf</span>.</p>
            <p>
              Let your wants change you like <span class="wd-myth">Fáfnir</span
              >.
            </p>
            <p>
              Save a princess and blackmail townsfolk like <span class="wd-myth"
                >Saint George</span
              >.
            </p>
          </div>

          <p class="wd-colophon wd-full">
            Written by Piotr Monwid-Olechnowicz. Illustrated by Rouzeris.
            Proofread by Zack Thomson, Wafergix, Łukasz Bartoszewicz, Radek MG.
          </p>
          <p class="wd-colophon wd-full">
            Based on <em>1 HP Dragon</em> by Clayton Notestine. <em
              >Face Fury</em
            > adapts Jeremy Strandberg's <em>Defy Danger, Restated</em>, used
            under CC BY-SA 4.0. The ruleset is shared under CC BY-SA 4.0.
          </p>
          <div class="wd-marker wd-lower">
            <span>lol.haspar.us/why-dragon</span><span>hasparus.itch.io</span>
          </div>
        </article>
        <img
          class="wd-dragon-overlay"
          src={dragonUrl}
          alt="Dragon perched on burning spires"
        />
      </div>

      <div class="wd-sheet wd-booklet">
        <article class="wd-page wd-verso">
          <span class="wd-pageno">2 · moves I</span>

          <PrintMove name={title(FaceFury)} span="full">
            <FaceFury.Content />
          </PrintMove>

          <PrintMove name={title(Bellow)}>
            <Bellow.Content />
          </PrintMove>

          <PrintMove name={title(StokeTheFire)}>
            <StokeTheFire.Content />
          </PrintMove>

          <PrintMove name={title(RelinquishYourGoal)}>
            <RelinquishYourGoal.Content />
          </PrintMove>

          <PrintMove name={title(Burn)}>
            <Burn.Content />
          </PrintMove>

          <section class="wd-full wd-dm mt-4">
            <div>
              <h3 class="wd-rubric">DM's Agenda</h3>
              <ul>
                <li><span>Make the Dragon vast and terrible.</span></li>
                <li><span>Learn what they're willing to burn.</span></li>
                <li><span>See what's left when the smoke clears.</span></li>
              </ul>
            </div>
            <div>
              <h3 class="wd-rubric">DM Moves</h3>
              <p>
                Hurt, Raze, Capture, Separate,<br />Reveal, Bargain, Soar,
                Threaten.
              </p>
            </div>
          </section>

          <section class="wd-full wd-dragon-box mt-4">
            <h3 class="wd-rubric">The Dragon</h3>
            <TheDragon.Content />
          </section>
        </article>

        <article class="wd-page wd-recto wd-flow">
          <span class="wd-pageno">3 · moves II</span>

          <PrintMove name={title(JumpIntoFlames)}>
            <JumpIntoFlames.Content />
          </PrintMove>

          <PrintMove name={title(ThrowSand)}>
            <ThrowSand.Content />
          </PrintMove>

          <PrintMove name={title(TurnToAsh)}>
            <TurnToAsh.Content />
          </PrintMove>

          <PrintMove name={title(LevelUp)}>
            <LevelUp.Content />
          </PrintMove>

          <PrintMove
            name={title(Aftermath)}
            class="wd-break break-before-column"
          >
            <Aftermath.Content />
          </PrintMove>

          <PrintMove name={title(RaiseAToast)}>
            <RaiseAToast.Content />
          </PrintMove>
        </article>
        <img class="wd-sword-overlay" src={swordUrl} alt="Dragon sword" />
      </div>

      {
        [0, 1].map(() => (
          <div class="wd-sheet wd-hunters">
            <HunterPage />
            <HunterPage />
          </div>
        ))
      }

      <aside
        class="text-neu-500 dark:text-neu-400 fixed top-6 left-6 flex flex-col items-start gap-2 font-mono text-xs print:hidden"
      >
        <label
          class="text-neu-500 hover:bg-neu-200/70 hover:text-neu-900 dark:text-neu-400 dark:hover:bg-neu-800 dark:hover:text-neu-50 flex cursor-pointer items-center justify-center px-1 py-0.5 font-mono text-xs transition hover:duration-0"
        >
          <input type="checkbox" id="wd-grid" class="sr-only" />
          <span class="wd-grid-off">[grid off]</span>
          <span class="wd-grid-on">[grid on]</span>
        </label>
        <label
          class="text-neu-500 hover:bg-neu-200/70 hover:text-neu-900 has-[:checked]:text-neu-900 dark:text-neu-400 dark:hover:bg-neu-800 dark:hover:text-neu-50 dark:has-[:checked]:text-neu-50 flex cursor-pointer items-center justify-center px-1 py-0.5 font-mono text-xs transition hover:duration-0"
        >
          <input
            type="radio"
            name="wd-print"
            id="wd-print-booklet"
            class="sr-only"
            checked
          />
          <span>[booklet]</span>
        </label>
        <label
          class="text-neu-500 hover:bg-neu-200/70 hover:text-neu-900 has-[:checked]:text-neu-900 dark:text-neu-400 dark:hover:bg-neu-800 dark:hover:text-neu-50 dark:has-[:checked]:text-neu-50 flex cursor-pointer items-center justify-center px-1 py-0.5 font-mono text-xs transition hover:duration-0"
        >
          <input
            type="radio"
            name="wd-print"
            id="wd-print-hunters"
            class="sr-only"
          />
          <span>[4 hunters]</span>
        </label>
        <span class="wd-print-note-booklet px-1">fold on short edge</span>
        <span class="wd-print-note-hunters px-1">cut in half</span>
      </aside>
    </div>
    <script>
      import {
        layoutNextLineRange,
        prepareWithSegments,
        type LayoutCursor,
      } from "@chenglou/pretext";

      const relayoutMoves = () => {
        // Skip the column-flow page: min-height only aligned grid rows, and
        // estimator overshoot shows up as blank space inside the column.
        for (const move of document.querySelectorAll<HTMLElement>(
          ".wd-move:not(.wd-flow .wd-move)",
        )) {
          const copy = move.querySelector<HTMLElement>(".wd-move-copy");
          const initial = move.querySelector<HTMLElement>(".wd-initial");
          if (!copy || !initial) continue;

          const text = copy.textContent?.replace(/\s+/g, " ").trim();
          if (!text) continue;

          const cs = getComputedStyle(copy);
          const size = parseFloat(cs.fontSize);
          const lineHeight = parseFloat(cs.lineHeight) || size * 1.24;
          const font = `${cs.fontWeight} ${size}px ${cs.fontFamily}`;
          const prepared = prepareWithSegments(text, font);
          const initialWidth =
            initial.getBoundingClientRect().width +
            parseFloat(getComputedStyle(initial).marginRight || "0");
          const initialHeight =
            initial.getBoundingClientRect().height +
            parseFloat(getComputedStyle(initial).marginBottom || "0");
          const width = move.clientWidth;
          if (!width) continue;

          let cursor: LayoutCursor = { segmentIndex: 0, graphemeIndex: 0 };
          let y = 0;
          while (y < 2000) {
            const wrapsInitial = y < initialHeight;
            const available = wrapsInitial ? width - initialWidth : width;
            const range = layoutNextLineRange(prepared, cursor, available);
            if (range === null) break;
            cursor = range.end;
            y += lineHeight;
          }

          move.style.setProperty(
            "--wd-pretext-min-height",
            `${Math.max(initialHeight, y)}px`,
          );
        }
      };

      if (document.fonts.status === "loaded") relayoutMoves();
      else void document.fonts.ready.then(relayoutMoves);

      new ResizeObserver(relayoutMoves).observe(document.body);

      // The visible move headings start at their second letter — the
      // illuminated initial images stand in for the first — which breaks
      // search and copy in exported PDFs ("ace Fury"). Collect the full names
      // into a near-invisible line in each page's bottom margin (.wd-page-alt)
      // so they survive in the text layer. See why-dragon.css for why neither
      // sr-only nor `transparent` text works in print.
      for (const page of document.querySelectorAll<HTMLElement>(".wd-page")) {
        const names = [...page.querySelectorAll(".wd-move-name")]
          .map((heading) => heading.getAttribute("aria-label"))
          .filter(Boolean)
          .join(" · ");
        if (!names) continue;
        const alt = document.createElement("span");
        alt.className = "wd-page-alt";
        alt.setAttribute("aria-hidden", "true");
        alt.textContent = names;
        page.append(alt);
      }
    </script>
  </body>
</html>
