---
/* eslint-disable better-tailwindcss/no-unknown-classes */
interface Props {
  name: string;
  span?: "3" | "4" | "full";
  class?: string;
}

const { name, span = "3", class: className } = Astro.props;
const spanClass =
  span === "full" ? "wd-full" : span === "4" ? "wd-span-4" : "wd-span-3";
const trimmed = name.trim();
const rest = trimmed.slice(1);
const initialSlug = trimmed
  .toLowerCase()
  .replaceAll(/[^\w]+/g, "-")
  .replaceAll(/^-+|-+$/g, "");
const initialSrc = `/books/why-dragon/initials/${initialSlug}.png`;
---

<div class:list={["wd-move", spanClass, className]}>
  <span class="wd-initial" aria-hidden="true">
    <img
      src={initialSrc}
      width="768"
      height="768"
      alt=""
      loading="eager"
      decoding="async"
    />
  </span>
  <div class="wd-move-copy">
    <h3 class="wd-move-name" aria-label={name}>{rest}</h3>
    <slot />
  </div>
</div>
