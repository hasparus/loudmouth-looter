---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Link } from "../../lib/Link";
import PostCard from "../../lib/PostCard.astro";
import { getEntries, type PostEntry, tagSlug } from "../../lib/posts";
import type { TalkEntry } from "../../talks/talks";
import { SITE_NAME } from "../../lib/siteMeta";

export async function getStaticPaths() {
  const bySlug = new Map<
    string,
    { label: string; posts: (PostEntry | TalkEntry)[] }
  >();
  for (const post of getEntries()) {
    for (const tag of post.frontmatter.tags ?? []) {
      const slug = tagSlug(tag);
      if (!slug) continue;
      const entry = bySlug.get(slug) ?? { label: tag, posts: [] };
      entry.posts.push(post);
      bySlug.set(slug, entry);
    }
  }

  return [...bySlug].map(([slug, { label, posts: tagged }]) => ({
    params: { tag: slug },
    props: { label, posts: tagged },
  }));
}

interface Props {
  label: string;
  posts: (PostEntry | TalkEntry)[];
}

const { label, posts } = Astro.props;
---

<BaseLayout
  title={`§ ${label} — ${SITE_NAME}`}
  description={`Posts tagged ${label}.`}
>
  <h1
    slot="header-content"
    class="text-neu-600 dark:text-neu-400 flex items-baseline gap-2 font-serif font-bold"
  >
    <Link href="/" noUnderline class="text-neu-400 dark:text-neu-600">←</Link>
    <span class="text-neu-400 dark:text-neu-200">§</span>
    {label}
  </h1>

  <div class="zaduma-prose py-10">
    <p>
      {`${posts.length} ${posts.length === 1 ? "entry" : "entries"} tagged `}<em
        >{label}</em
      >.
    </p>
  </div>

  <ul class="-my-4">
    {
      posts.map((post) => (
        <li>
          <PostCard post={post} class="-mx-4 p-4 pt-2" />
        </li>
      ))
    }
  </ul>
</BaseLayout>
