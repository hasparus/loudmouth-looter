{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ESNext", "ES2025"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "skipLibCheck": true,
    "types": ["node", "bun"],
    "allowJs": true
  },
  "include": ["src", "api", "e2e", "*.ts"]
}
