{
  "name": "loudmouth-looter",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "vercel:dev": "vercel dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "serve": "astro preview",
    "astro": "astro",
    "lint": "eslint src api e2e .github/scripts playwright.config.ts astro.config.ts --max-warnings 0",
    "typecheck": "astro check && tsc --noEmit && tsc --noEmit -p src/editor/tsconfig.json",
    "format": "prettier --write src api e2e .github/scripts playwright.config.ts astro.config.ts",
    "ci": "bun run lint && prettier --check src api e2e .github/scripts playwright.config.ts astro.config.ts",
    "test": "playwright test",
    "test:unit": "bun test src"
  },
